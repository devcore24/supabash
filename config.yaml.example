core:
  log_level: INFO
  save_reports: true
  report_exports:
    html: false
    pdf: false
  allowed_hosts:
  - localhost
  - 127.0.0.1
  consent_accepted: false
  allow_public_ips: false
  # Hard ceilings applied in aggressive mode.
  aggressive_caps:
    max_nuclei_rate: 20
    default_nuclei_rate: 10
    max_gobuster_threads: 50
    max_parallel_workers: 6
llm:
  enabled: true
  max_input_chars: 12000
  # Optional fallback for chat context % (useful for local models).
  max_input_tokens: 0
  cache_enabled: false
  cache_ttl_seconds: 3600
  cache_max_entries: 500
  # When true, only local providers are allowed (ollama/lmstudio).
  local_only: false
  provider: openai
  anthropic:
    # A non-placeholder inline key takes precedence over api_key_env.
    api_key: ""
    api_key_env: ANTHROPIC_API_KEY
    model: claude-opus-4-5
    api_base: https://api.anthropic.com
  gemini:
    api_key: ""
    api_key_env: GEMINI_API_KEY
    model: gemini-3-pro
  openai:
    api_key: ""
    api_key_env: OPENAI_API_KEY
    model: gpt-5.1
  mistral:
    api_key: ""
    api_key_env: MISTRAL_API_KEY
    model: mistral-large-2512
    api_base: https://api.mistral.ai/v1
  ollama:
    api_key: null
    model: ollama/llama3.1
    api_base: http://localhost:11434
  lmstudio:
    api_key: null
    model: local-model
    api_base: http://localhost:1234/v1
chat:
  history_max_messages: 80
  max_message_chars: 4000
  llm_history_turns: 6
  summary_every_turns: 4
  summary_keep_last_messages: 24
  max_summary_chars: 1200
  redact_secrets: true
# Experimental Codex CLI planner backend. Codex proposes actions while Supabash
# validates scope, executes its wrappers, and owns evidence/report generation.
codex:
  command: codex
  # Optional explicit Codex model override. Leave null to use Codex's available default.
  model: null
  # Optional auth-only home for maximum isolation. Authenticate it separately with:
  # CODEX_HOME=/path/to/auth-only-home codex login
  # Global AGENTS.md/AGENTS.override.md files in the effective home must be absent or empty.
  codex_home: null
  timeout_seconds: 300
  preflight_timeout_seconds: 10
  sandbox: read-only
  # Require an existing ChatGPT-subscription login instead of silently using an API key.
  require_chatgpt: true
  # Ignore mutable Codex CLI behavior settings while retaining CODEX_HOME authentication.
  ignore_user_config: true
  # Ephemeral by default so target context is not retained in Codex's session store.
  # Set true only when you explicitly want resumable per-engagement Codex context.
  persistent_thread: false
  # Bound the evidence/context sent to each planner turn.
  max_input_chars: 24000
  # Defensive per-turn limits for captured Codex JSONL events. Supabash caps
  # these at 1,000 events and 32,768 characters per event. The sanitized,
  # metadata-only engagement trace is separately capped at 4 MiB/4,000 records.
  max_events: 500
  max_event_chars: 16384
  # Planner-only boundary: Codex reasons; Supabash executes registered tools.
  disabled_features:
    - plugins
    - remote_plugin
    - apps
    - shell_tool
    - browser_use
    - computer_use
    - in_app_browser
    - image_generation
    - multi_agent
    - workspace_dependencies
# Tool registry (enable/disable tools globally)
# Notes:
# - Some tools are conditional/opt-in at runtime (e.g. sqlmap requires a parameterized URL, nikto is slow/noisy).
# - Both `enum4linux_ng` and `enum4linux-ng` key forms are accepted.
tools:
  nmap:
    enabled: true
    timeout_seconds: 600
    fast_discovery: true
    fast_discovery_ports: 1-65535
    fast_discovery_max_ports: 256
  masscan:
    enabled: true
    timeout_seconds: 600
    rate: 1000
    ports: 1-65535
  rustscan:
    enabled: true
    timeout_seconds: 600
    batch: 2000
    ports: 1-65535
  subfinder:
    enabled: false
    timeout_seconds: 600
    max_candidates: 200
    max_promoted_hosts: 40
    resolve_validation: true
  httpx:
    enabled: true
    timeout_seconds: 300
  whatweb:
    enabled: true
    timeout_seconds: 300
  nuclei:
    # Enabled by default because broad Nuclei coverage is part of the baseline audit pipeline.
    enabled: true
    timeout_seconds: 1800
    rate_limit: 10
    # Optional safety cap for the multi-target broad baseline nuclei pass in normal mode.
    # Set to 0 to fully respect `rate_limit` even during the broad baseline pass.
    normal_mode_broad_rate_limit: 0
    tags: ""
    severity: ""
  gobuster:
    enabled: true
    timeout_seconds: 1800
  ffuf:
    enabled: false
    timeout_seconds: 1800
  katana:
    enabled: true
    timeout_seconds: 1800
    depth: 3
    concurrency: 10
  browser_use:
    enabled: true
    timeout_seconds: 900
    max_steps: 25
    min_steps_success: 1
    require_done: true
    # Deprecated compatibility key. Guarded scans never create native CLI sessions.
    auto_session: false
    headless: true
    # Named sessions use the native CLI and are rejected by guarded scans.
    session: ""
    # Profiles remain supported by the policy-enforcing Python-library path.
    profile: ""
    model: ""
    # Optional: Supabash exports this as BROWSER_USE_API_KEY for the isolated Python runtime.
    # Prefer a lab/test key here if you choose to store it in config.
    api_key: ""
    # Optional: read from another env var and export into BROWSER_USE_API_KEY (used when api_key is empty).
    api_key_env: ""
    # Deprecated compatibility key. Native CLI fallback is disabled because it cannot
    # enforce exact-origin boundaries before navigation.
    allow_deterministic_fallback: false
    deterministic_max_paths: 8
    # Deprecated compatibility key. Custom commands are rejected by guarded scans.
    command: ""
    auth:
      enabled: false
      login_url: ""
      notes: ""
      # Direct values are supported for a private, owner-only config. Keep them
      # blank in this example and prefer the env fields for shared deployments.
      username: ""
      password: ""
      cookie: ""
      username_env: ""
      password_env: ""
      cookie_env: ""
      include_secrets_in_task: false
      # Unsafe compatibility option: embedded secrets can be visible in local process arguments.
  sqlmap:
    enabled: true
    timeout_seconds: 1800
  nikto:
    enabled: false
    timeout_seconds: 1200
  sslscan:
    enabled: true
    timeout_seconds: 600
  dnsenum:
    enabled: true
    timeout_seconds: 900
  enum4linux_ng:
    enabled: true
    timeout_seconds: 1200
  searchsploit:
    enabled: false
    timeout_seconds: 120
  trivy:
    enabled: true
    timeout_seconds: 1800
  scoutsuite:
    enabled: false
    timeout_seconds: 3600
    provider: aws
    arguments: ""
  prowler:
    enabled: false
    timeout_seconds: 3600
    arguments: ""
  supabase_audit:
    enabled: true
    timeout_seconds: 10
    max_pages: 5
    # Only these explicit backends (plus direct *.supabase.co targets) receive
    # read-only REST/RPC root probes. Backends discovered in page content are reported only.
    extra_urls: []
    # Example: extra_urls: ["http://127.0.0.1:4001"]
  readiness_probe:
    enabled: true
    max_web_targets: 30
  hydra:
    enabled: false
    timeout_seconds: 3600
  medusa:
    enabled: false
    timeout_seconds: 3600
  wpscan:
    enabled: true
    timeout_seconds: 1200
    # Optional: WPScan API token for vulnerability data
    api_token: ""
    enumerate: ""
    arguments: ""
  theharvester:
    enabled: true
    timeout_seconds: 900
    sources: ""
    limit: 500
    start: 0
    arguments: ""
  netdiscover:
    enabled: true
    timeout_seconds: 300
  aircrack_ng:
    enabled: false
    timeout_seconds: 120
    airmon: false
    channel: ""
    arguments: ""
  crackmapexec:
    enabled: true
    timeout_seconds: 600
